# PostgreSQL (connexion directe)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rdv
# Secret NextAuth : openssl rand -base64 32
AUTH_SECRET=change-me
# URL publique de l'app (recommandé en prod)
AUTH_URL=http://localhost:3000

# --- Emails (Resend) ---
# Clé API : https://resend.com/api-keys (permission "Sending access" suffit)
RESEND_API_KEY=
# Expéditeur, sur un domaine vérifié dans Resend
EMAIL_FROM="Reservy <rdv@ton-domaine.fr>"
# Adresse de réponse par défaut (optionnel)
EMAIL_REPLY_TO=
# URL publique utilisée dans les liens des emails (sinon AUTH_URL)
APP_URL=http://localhost:3000
# Fuseau des dates écrites dans les emails
APP_TIMEZONE=Europe/Paris
# Exiger la confirmation d'email à la connexion (true par défaut dès que Resend est configuré)
REQUIRE_EMAIL_VERIFICATION=true
# Secret pour l'appel horaire des rappels J-1 : openssl rand -hex 32
CRON_SECRET=
